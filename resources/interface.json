{
  "interface_version": 2,
  "name": "alas-maa",
  "label": "Alas Maa",
  "title": "Alas Maa 0.1.0",
  "version": "0.1.0",
  "description": "将 Alas 的碧蓝航线自动化能力接入 MaaFramework 的 Android 宿主。",
  "contact": "https://github.com/Justccerly/alas-maa",
  "license": "GPL-3.0-or-later",
  "github": "https://github.com/Justccerly/alas-maa",
  "controller": [
    {
      "name": "Android",
      "label": "Android ADB",
      "type": "Adb"
    }
  ],
  "resource": [
    {
      "name": "Default",
      "label": "默认资源",
      "path": [
        "resource/base"
      ],
      "controller": [
        "Android"
      ]
    }
  ],
  "group": [
    {
      "name": "diagnostic",
      "label": "诊断"
    }
  ],
  "import": [
    "tasks/startup.json"
  ],
  "option": {
    "游戏服务器": {
      "type": "select",
      "label": "游戏服务器",
      "description": "选择需要通过 ADB 启动的碧蓝航线客户端包名。",
      "cases": [
        {
          "name": "CN",
          "label": "国服 B 服",
          "pipeline_override": {
            "AlasStartGame": {
              "package": "com.bilibili.azurlane"
            }
          }
        },
        {
          "name": "EN",
          "label": "国际服 EN",
          "pipeline_override": {
            "AlasStartGame": {
              "package": "com.YoStarEN.AzurLane"
            }
          }
        },
        {
          "name": "JP",
          "label": "日服 JP",
          "pipeline_override": {
            "AlasStartGame": {
              "package": "com.YoStarJP.AzurLane"
            }
          }
        },
        {
          "name": "TW",
          "label": "港澳台服",
          "pipeline_override": {
            "AlasStartGame": {
              "package": "com.hkmanjuu.azurlane.gp"
            }
          }
        }
      ]
    }
  }
}
